# =============================================================================
# HyperPod (EKS) + vLLM 部署参数 —— 复制为 config.env 后修改
# 所有脚本只读取本文件；迁移区域 / 机型时只改这里
# =============================================================================

# ---------- 区域与命名 ----------
REGION=us-east-1
NAME_PREFIX=hp-qwen

# ---------- 网络 ----------
VPC_CIDR=10.60.0.0/16
HYPERPOD_AZ_ID=use1-az6          # HyperPod 节点所在 AZ ID（01-preflight 会校验机型供应）
SECOND_AZ_ID=use1-az1            # EKS 控制面要求的第二个 AZ
# 可选（最多 3 个）：额外私有子网，HYPERPOD_AZ_ID 容量不足时由 04b-capacity-race.sh 在多个 AZ 竞速申请
EXTRA_AZ_IDS=
# EKS API 公网白名单：auto=自动探测运维机公网 IP/32；留空=只开内网端点；也可填逗号分隔的 CIDR
EKS_PUBLIC_ACCESS_CIDRS=auto

# ---------- EKS ----------
EKS_VERSION=1.35                 # HyperPod 支持 1.30–1.35
OPERATOR_ROLE_ARN=               # 留空=自动取当前调用身份对应的 IAM 角色

# ---------- HyperPod ----------
INSTANCE_TYPE=ml.g5.12xlarge
INSTANCE_GROUP_NAME=gpu-inference   # 换机型时建议换名（实例组的机型创建后不能改）
INSTANCE_COUNT=1
EBS_VOLUME_GB=300                # 挂载到 /opt/sagemaker
DEEP_HEALTH_CHECKS=              # 例如 InstanceStress 或 InstanceStress,InstanceConnectivity
NODE_RECOVERY=Automatic
TRAINING_PLAN_ARN=

# ---------- S3 ----------
S3_BUCKET=                       # 留空=sagemaker-hyperpod-<acct>-<region>；必须以 sagemaker- 开头

# ---------- 模型 ----------
MODEL_ID=Qwen/Qwen3.6-35B-A3B    # 备选 Qwen/Qwen3.6-35B-A3B-FP8
MODEL_SOURCE=s3                  # s3 | hf
MODEL_S3_PREFIX=models/Qwen3.6-35B-A3B
HF_TOKEN=                        # 只有受限模型需要

# ---------- vLLM ----------
VLLM_IMAGE=                      # 留空=763104351884.dkr.ecr.${REGION}.amazonaws.com/vllm:0.31.0-gpu-py312-ec2
TP_SIZE=4
MAX_MODEL_LEN=32768
GPU_MEM_UTIL=0.92
MAX_NUM_SEQS=16
VLLM_EXTRA_ARGS="--language-model-only --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder"
SERVED_MODEL_NAME=qwen3.6-35b-a3b
# vLLM Pod 资源（需小于节点可分配量）：g5.12xlarge 48 vCPU/192 GiB；g6e.xlarge 4 vCPU/32 GiB → 3 / 20Gi / 28Gi / 2Gi
VLLM_CPU_REQUEST=16
VLLM_MEM_REQUEST=96Gi
VLLM_MEM_LIMIT=170Gi
SHM_SIZE=16Gi                    # 多卡 TP 需要较大 /dev/shm；TP=1 时 2Gi 即可
API_KEY=                         # 留空=首次部署自动生成并保存到 K8s Secret

# 集群组件：纯推理 + 小机型（maxPods 低）时可关闭训练 operator、coredns 只留 1 副本
HYPERPOD_TRAINING_OPERATORS=true # Kubeflow Training Operator + MPI Operator
COREDNS_REPLICAS=2
SYSTEM_NODE_TYPE=t3.large        # EKS 托管 CPU 节点组：运行 LBC / coredns 等控制器；留空=不创建
SYSTEM_NODE_COUNT=1              # 生产建议 2（控制器高可用）

# ---------- 服务暴露 ----------
# port-forward : 仅调试（kubectl port-forward，只在运维终端可用）
# internal-nlb : 生产·内网 L4（同 VPC / TGW / DX / 对等连接）；可选 TLS
# alb          : 生产·L7 HTTPS（internal 或 internet-facing），支持 WAF / 来源白名单 / 域名
EXPOSE_MODE=internal-nlb
NLB_SOURCE_RANGES=               # 允许访问 NLB 的 CIDR（逗号分隔），留空=VPC_CIDR；加上客户 IDC/其它 VPC 网段
NLB_ACM_CERT_ARN=                # 可选：ACM 证书 ARN → NLB 443 TLS 监听
ALB_SCHEME=internal              # internal | internet-facing（后者必须配置证书）
ALB_INBOUND_CIDRS=               # 允许访问 ALB 的 CIDR，留空=VPC_CIDR；0.0.0.0/0 只有配置了 WAF 才允许
ALB_ACM_CERT_ARN=                # ACM 证书 ARN（HTTPS 443）
ALB_WAF_ACL_ARN=                 # 可选：WAFv2 Web ACL ARN（REGIONAL）
ALB_IDLE_TIMEOUT=900             # 秒；思考模式 / 长输出需要较长空闲超时
DOMAIN_NAME=                     # 可选：自定义域名（需与证书匹配）
ROUTE53_ZONE_ID=                 # 可选：填写后自动创建 DOMAIN_NAME → LB 的 Alias 记录
K8S_NAMESPACE=llm
